# Sao chép file này thành .env rồi điền giá trị (hoặc để launcher.py tự tạo).
# .env đã nằm trong .gitignore — không bị commit, không lộ key.

# Bắt buộc nếu muốn nhận dạng ảnh (lấy miễn phí: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tuỳ chọn
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=180
# PORT=8000

# Chuỗi dự phòng khi model chính bận (429/503/timeout):
# model chính -> model trong danh sách dưới -> key trong GEMINI_API_KEYS (bỏ trống = không dùng)
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.0-flash
# GEMINI_API_KEYS=key_chinh,key_du_phong
